# Facilitron Vale config — copied VERBATIM from the tron plugin
# (skills/prose-lint/vale-ini.template) by the vale-prose-runner scaffold.
# The style pack itself is symlinked into .vale/styles (gitignored); this file is
# committed and stays portable because it never contains a machine-specific path.
# NO Microsoft package — too noisy.

StylesPath = .vale/styles
MinAlertLevel = suggestion
Packages = write-good, alex
Vocab = Facilitron

[*.md]
BasedOnStyles = Vale, Facilitron, write-good, alex
Vale.Spelling = NO
write-good.E-Prime = NO
alex.ProfanityUnlikely = NO

# Ignore Nuxt/MDC component fences (::card … ::, including nested ::: variants and
# {prop} attribute braces) — they are markup, not prose.
BlockIgnores = (?s) *(::+[\w-]+(\{[^{}\n]*\})?.*?\n *::+)
# Ignore inline/display math ($…$ and $$…$$), inline code spans, and the bolded
# AP press-release dateline. The dateline carries an em dash in every variant the
# corpus uses (`**LOS GATOS, Calif., July 1, 2026 —**` and
# `**LOS GATOS, Calif. — February 24, 2026**` both ship), and it is the one place
# the dash is correct. It is exempted here rather than in Facilitron.EmDash
# because RE2 has no lookaround, so the rule itself cannot say "except after a
# city and a year". Matching the whole bolded run works for every variant.
# The pattern needs no literal comma on purpose: Vale splits *Ignores values on
# commas, so `[^*\n]*` spans the city/state/date commas instead of naming them.
TokenIgnores = (\$+[^\n$]+\$+), (`[^`\n]+`), (\*\*[A-Z][^*\n]*\d{4}[^*\n]*\*\*)
